module

public import Heights.SubspaceTheorem.Parallelepiped

/-!
# Schmidt's Subspace Theorem

We deduce the Subspace Theorem from its version for parallelepipeds
(`Schmidt.parallelepiped_theorem`, [evertse1993], Theorem 3.2.1).

## Main results

* `Schmidt.subspace_theorem`: **Schmidt's Subspace Theorem**. Let `L₁, …, Lₙ` be linearly
  independent linear forms in `n ≥ 2` variables with (real or complex) algebraic coefficients and
  let `ε > 0`. Then the set of solutions `x ∈ ℤⁿ` of `|L₁(x) ⋯ Lₙ(x)| ≤ ‖x‖ ^ (-ε)` is contained
  in the union of finitely many proper linear subspaces of `ℚⁿ`.
* `Schmidt.subspace_theorem_real`, `Schmidt.subspace_theorem_complex`: the same statement for
  linear forms given by an invertible matrix with real, respectively complex, algebraic entries.

## Structure of the proof

We follow [evertse1993], Section 3, which in turn follows [schmidt1980], Chapters IV–VI.

1. *Reduction to real coefficients* (`Schmidt.exists_real_matrix`, this file).
2. *Reduction to parallelepipeds* (`Schmidt.subspace_theorem_real`, this file): the Subspace
   Theorem follows from `Schmidt.parallelepiped_theorem` ([evertse1993], Theorem 3.2.1), using the
   Liouville-type inequality `Schmidt.exists_le_abs_linearForm` (file `LinearForms`).
3. *Step 1: reduction to parallelepipeds of rank `n - 1`* (file `Parallelepiped`):
   `Schmidt.parallelepiped_theorem` follows from `Schmidt.exists_compound_box`
   ([evertse1993], Proposition 3.3.2, file `CompoundBox`) and
   `Schmidt.parallelepiped_theorem_of_rank` (file `PenultimateMinimum`), applied to the compound
   matrices of `L` (file `Compound`).
4. *Step 2: parallelepipeds of rank `n - 1`* (`Schmidt.parallelepiped_theorem_of_rank`,
   [evertse1993], Section 3.4). This uses the Roth machinery: `Schmidt.polynomial_theorem`,
   `Schmidt.generalized_roth_lemma` (file `Index`), `Schmidt.size_rpow_le_norm_normal`
   (file `PenultimateMinimum`) and `Schmidt.exists_hasseDeriv_eval_ne_zero` (file `Polynomial`).

## Status

All the results are proved, with no `sorry`; they depend only on the axioms `propext`,
`Classical.choice` and `Quot.sound`. References to Schmidt's book are to W. M. Schmidt,
*Diophantine Approximation*, LNM 785.

Schmidt's generalisation of Roth's lemma `Schmidt.generalized_roth_lemma` (file
`GeneralizedRothLemma`, Ch. VI, Theorem 10B) is reduced to Roth's lemma (file `RothLemma`, Ch. V,
Theorem 10A), which is proved by induction on the number of variables using generalized
Wronskians (file `Wronskian`; the non-vanishing lemma `Schmidt.exists_wronskian_ne_zero`, Ch. V,
Lemma 9A, is in the file `GeneralizedWronskian`). The polynomial theorem `Schmidt.polynomial_theorem` (file
`PolynomialTheorem`, Ch. VI, Theorem 7A of Schmidt's book) is proved with Siegel's lemma over the
number field generated by the entries of `L⁻¹`. Minkowski's second theorem for parallelepipeds,
`Schmidt.exists_successive_minima` (file `Minkowski`), is proved with the non-sharp constant
`n ^ n` from Minkowski's first theorem (W. M. Schmidt, *Diophantine Approximation*, LNM 785,
Ch. IV, Lemmas 1D and 1E). Step 1 (`Schmidt.exists_compound_box`, file `CompoundBox`) is deduced
from `Schmidt.exists_successive_minima`, `Schmidt.exists_unipotent_mul_le` (file
`UnipotentReduction`) and the Cauchy–Binet formula `Schmidt.compound_mul` (file `Compound`).
Step 2 (`Schmidt.parallelepiped_theorem_of_rank`, file `PenultimateMinimum`) is deduced from
`Schmidt.generalized_roth_lemma`, `Schmidt.polynomial_theorem`,
`Schmidt.size_rpow_le_norm_normal` and the Taylor expansion lemmas of the file `HasseTaylor`.

See also the file `Roth`, where Roth's theorem is deduced from the case `n = 2`.
-/

@[expose] public section

open Matrix

namespace Schmidt

variable {ι κ : Type*} [Fintype ι]

/-! ### Elementary estimates for linear forms -/

lemma abs_eval_le (L : Matrix κ ι ℝ) (x : ι → ℤ) (i : κ) :
    |eval L x i| ≤ (∑ j, |L i j|) * ‖x‖ := by
  rw [eval_apply, Finset.sum_mul]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun j _ ↦ ?_)
  rw [abs_mul]
  gcongr
  have := norm_le_pi_norm x j
  rwa [Int.norm_eq_abs] at this

lemma norm_le_of_abs_eval_le [DecidableEq ι] (L : Matrix ι ι ℝ) (hL : L.det ≠ 0) (x : ι → ℤ)
    {B : ℝ} (hB : ∀ i, |eval L x i| ≤ B) : ‖x‖ ≤ (∑ j, ∑ i, |L⁻¹ j i|) * B := by
  rcases isEmpty_or_nonempty ι with h | ⟨⟨i₀⟩⟩
  · simp [Subsingleton.elim x 0]
  have hB0 : 0 ≤ B := (abs_nonneg _).trans (hB i₀)
  have key : (fun j ↦ (x j : ℝ)) = L⁻¹ *ᵥ eval L x := by
    rw [eval, Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hL),
      Matrix.one_mulVec]
  have hnn : 0 ≤ (∑ j, ∑ i, |L⁻¹ j i|) * B :=
    mul_nonneg (Finset.sum_nonneg fun _ _ ↦ Finset.sum_nonneg fun _ _ ↦ abs_nonneg _) hB0
  refine (pi_norm_le_iff_of_nonneg hnn).mpr fun j ↦ ?_
  rw [Int.norm_eq_abs, congrFun key j, Matrix.mulVec, dotProduct]
  calc |∑ i, L⁻¹ j i * eval L x i| ≤ ∑ i, |L⁻¹ j i| * B := by
        refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ ↦ ?_)
        rw [abs_mul]
        gcongr
        exact hB i
    _ = (∑ i, |L⁻¹ j i|) * B := by rw [Finset.sum_mul]
    _ ≤ (∑ j, ∑ i, |L⁻¹ j i|) * B :=
        mul_le_mul_of_nonneg_right (Finset.single_le_sum (f := fun j ↦ ∑ i, |L⁻¹ j i|)
          (fun _ _ ↦ Finset.sum_nonneg fun _ _ ↦ abs_nonneg _) (Finset.mem_univ j)) hB0

/-- There are finitely many integer points of bounded norm. -/
lemma finite_setOf_norm_lt (R : ℝ) : {x : ι → ℤ | ‖x‖ < R}.Finite :=
  (isCompact_closedBall (0 : ι → ℤ) R).finite_of_discrete.subset fun x hx ↦ by
    simpa using le_of_lt hx

/-! ### The Subspace Theorem for real linear forms -/

/-- The Subspace Theorem for real linear forms, for a linearly ordered index type: this follows
[evertse1993], proof that Theorem 3.2.1 implies Theorem 1.5. -/
private theorem subspace_theorem_real_aux [LinearOrder ι] [Nontrivial ι] (L : Matrix ι ι ℝ)
    (hL : L.det ≠ 0) (halg : ∀ i j, IsAlgebraic ℚ (L i j)) {ε : ℝ} (hε : 0 < ε) :
    CoveredByProperSubspaces (solutionSet L ε) := by
  -- Liouville's inequality for each of the linear forms
  have hLiou (i : ι) := exists_le_abs_linearForm (L i) (halg i)
  choose c hc D hD using hLiou
  obtain ⟨D₀, hD₀⟩ : ∃ D₀ : ℕ, D₀ = ∑ i, D i := ⟨_, rfl⟩
  have hDle : ∀ i, D i ≤ D₀ := fun i ↦ hD₀ ▸
    Finset.single_le_sum (f := D) (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ i)
  obtain ⟨E, hE⟩ : ∃ E : ℕ, E = D₀ + 2 := ⟨_, rfl⟩
  have hE0 : (0 : ℝ) < E := by rw [hE]; positivity
  obtain ⟨cmin, hcmin, hcmin_le⟩ : ∃ cmin : ℝ, 0 < cmin ∧ ∀ i, cmin ≤ c i :=
    ⟨Finset.univ.inf' Finset.univ_nonempty c, (Finset.lt_inf'_iff _).mpr fun i _ ↦ hc i,
      fun i ↦ Finset.inf'_le _ (Finset.mem_univ i)⟩
  obtain ⟨C₁, hC₁⟩ : ∃ C₁ : ℝ, ∀ i, ∑ j, |L i j| ≤ C₁ :=
    ⟨∑ i, ∑ j, |L i j|, fun i ↦ Finset.single_le_sum (f := fun i ↦ ∑ j, |L i j|)
      (fun _ _ ↦ Finset.sum_nonneg fun _ _ ↦ abs_nonneg _) (Finset.mem_univ i)⟩
  obtain ⟨C₂, hC₂, hC₂'⟩ : ∃ C₂ : ℝ, 0 < C₂ ∧ ∑ j, ∑ i, |L⁻¹ j i| ≤ C₂ :=
    ⟨(∑ j, ∑ i, |L⁻¹ j i|) + 1, by positivity, by linarith⟩
  -- the Subspace Theorem for parallelepipeds
  obtain ⟨T, hT, Q₀, hQ₀⟩ := parallelepiped_theorem L hL halg (ε := ε / (2 * E)) (by positivity)
  obtain ⟨R, hR1, hR2, hR3, hR4, hR5⟩ : ∃ R : ℝ, 1 ≤ R ∧ C₁ ≤ R ∧ cmin⁻¹ ≤ R ∧ C₂ * Q₀ ≤ R ∧
      C₂ * 2 ≤ R :=
    ⟨max 1 (max C₁ (max cmin⁻¹ (max (C₂ * Q₀) (C₂ * 2)))), by simp, by simp, by simp, by simp,
      by simp⟩
  -- the three kinds of solutions
  have h1 : CoveredByProperSubspaces (⋃ i, {x : ι → ℤ | eval L x i = 0}) :=
    .iUnion _ fun i ↦ .of_real_form (L i) fun h ↦
      hL (Matrix.det_eq_zero_of_row_eq_zero i fun j ↦ congrFun h j)
  have h2 : CoveredByProperSubspaces {x : ι → ℤ | ‖x‖ < R} := .of_finite (finite_setOf_norm_lt R)
  have h3 : CoveredByProperSubspaces {x : ι → ℤ | ∃ c ∈ T, c ⬝ᵥ x = 0} :=
    .of_normals T hT fun x hx ↦ hx
  refine ((h1.union h2).union h3).mono fun x hx ↦ ?_
  by_cases hzero : ∃ i, eval L x i = 0
  · exact .inl (.inl (Set.mem_iUnion.mpr hzero))
  by_cases hR : ‖x‖ < R
  · exact .inl (.inr hR)
  right
  push Not at hzero hR
  have hx1 : 1 ≤ ‖x‖ := hR1.trans hR
  have hx0 : 0 < ‖x‖ := zero_lt_one.trans_le hx1
  -- the parallelepiped attached to `x`
  obtain ⟨a, ha⟩ : ∃ a : ι → ℝ, a = fun i ↦ |eval L x i| := ⟨_, rfl⟩
  have ha_pos : ∀ i, 0 < a i := fun i ↦ by rw [ha]; exact abs_pos.mpr (hzero i)
  have hxbox : x ∈ box L a := fun i ↦ by rw [ha]
  have ha_le : ∀ i, a i ≤ ‖x‖ ^ E := fun i ↦ calc
    a i ≤ (∑ j, |L i j|) * ‖x‖ := by rw [ha]; exact abs_eval_le L x i
    _ ≤ ‖x‖ * ‖x‖ := by gcongr; exact (hC₁ i).trans (hR2.trans hR)
    _ = ‖x‖ ^ 2 := (sq _).symm
    _ ≤ ‖x‖ ^ E := pow_le_pow_right₀ hx1 (by omega)
  have ha_inv : ∀ i, (a i)⁻¹ ≤ ‖x‖ ^ E := fun i ↦ by
    have h' : cmin * (‖x‖ ^ D₀)⁻¹ ≤ a i := calc
      cmin * (‖x‖ ^ D₀)⁻¹ ≤ c i * (‖x‖ ^ D i)⁻¹ := by
        gcongr
        · exact (hc i).le
        · exact hcmin_le i
        · exact hDle i
      _ = c i * ‖x‖ ^ (-(D i : ℝ)) := by rw [Real.rpow_neg hx0.le, Real.rpow_natCast]
      _ ≤ a i := by rw [ha]; exact hD i x (hzero i)
    calc (a i)⁻¹ ≤ (cmin * (‖x‖ ^ D₀)⁻¹)⁻¹ := inv_anti₀ (by positivity) h'
      _ = cmin⁻¹ * ‖x‖ ^ D₀ := by rw [mul_inv, inv_inv]
      _ ≤ ‖x‖ * ‖x‖ ^ D₀ := by gcongr; exact hR3.trans hR
      _ = ‖x‖ ^ (D₀ + 1) := (pow_succ' _ _).symm
      _ ≤ ‖x‖ ^ E := pow_le_pow_right₀ hx1 (by omega)
  have hsize_le : size a ≤ ‖x‖ ^ E := size_le ha_le ha_inv
  have hsize_pos : 0 < size a := zero_lt_one.trans_le (one_le_size ha_pos)
  have hxsize : ‖x‖ ≤ C₂ * size a :=
    (norm_le_of_abs_eval_le L hL x (B := size a) fun i ↦ by
      simpa [ha] using le_size a i).trans (by gcongr)
  have hsize_ge : Q₀ ≤ size a := le_of_mul_le_mul_left ((hR4.trans hR).trans hxsize) hC₂
  have hsize2 : 2 ≤ size a := le_of_mul_le_mul_left ((hR5.trans hR).trans hxsize) hC₂
  -- the volume of the parallelepiped is small
  have hprod : ∏ i, a i < size a ^ (-(ε / (2 * E))) := by
    have h1 : ∏ i, a i ≤ ‖x‖ ^ (-ε) := by
      rw [ha, ← Finset.abs_prod]
      exact hx
    have h3 : size a ^ ((E : ℝ)⁻¹) ≤ ‖x‖ := calc
      size a ^ ((E : ℝ)⁻¹) ≤ (‖x‖ ^ E) ^ ((E : ℝ)⁻¹) :=
        Real.rpow_le_rpow hsize_pos.le hsize_le (by positivity)
      _ = ‖x‖ := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le, mul_inv_cancel₀ hE0.ne', Real.rpow_one]
    have h2 : ‖x‖ ^ (-ε) ≤ size a ^ (-(ε / E)) := calc
      ‖x‖ ^ (-ε) ≤ (size a ^ ((E : ℝ)⁻¹)) ^ (-ε) :=
        Real.rpow_le_rpow_of_nonpos (by positivity) h3 (by linarith)
      _ = size a ^ (-(ε / E)) := by
        rw [← Real.rpow_mul hsize_pos.le]
        congr 1
        field_simp
    have h4 : size a ^ (-(ε / E)) < size a ^ (-(ε / (2 * E))) := by
      refine Real.rpow_lt_rpow_of_exponent_lt (by linarith) ?_
      rw [neg_lt_neg_iff]
      exact div_lt_div_of_pos_left hε (by positivity) (by linarith)
    exact (h1.trans h2).trans_lt h4
  obtain ⟨c, hcT, hc⟩ := hQ₀ a ha_pos hprod hsize_ge
  exact ⟨c, hcT, hc x hxbox⟩

/-- **Schmidt's Subspace Theorem** for linear forms with real algebraic coefficients, given by
the rows of an invertible matrix `L`: if `n ≥ 2` and `ε > 0`, then the set of solutions `x ∈ ℤⁿ` of
`|L₁(x) ⋯ Lₙ(x)| ≤ ‖x‖ ^ (-ε)` is contained in the union of finitely many proper linear subspaces
of `ℚⁿ`. -/
theorem subspace_theorem_real [DecidableEq ι] [Nontrivial ι] (L : Matrix ι ι ℝ) (hL : L.det ≠ 0)
    (halg : ∀ i j, IsAlgebraic ℚ (L i j)) {ε : ℝ} (hε : 0 < ε) :
    CoveredByProperSubspaces (solutionSet L ε) := by
  let : LinearOrder ι := LinearOrder.lift' (Fintype.equivFin ι) (Fintype.equivFin ι).injective
  exact subspace_theorem_real_aux L (by convert hL) halg hε

/-! ### The Subspace Theorem for complex linear forms -/

lemma isAlgebraic_ofReal_re {z : ℂ} (hz : IsAlgebraic ℚ z) : IsAlgebraic ℚ (z.re : ℂ) := by
  have hconj : IsAlgebraic ℚ ((starRingEnd ℂ) z) :=
    hz.algHom (Complex.conjAe.toAlgHom.restrictScalars ℚ)
  have h2 : IsAlgebraic ℚ ((2 : ℂ)⁻¹) := by
    simpa using isAlgebraic_algebraMap (R := ℚ) (A := ℂ) (2⁻¹ : ℚ)
  have : (z.re : ℂ) = 2⁻¹ * (z + (starRingEnd ℂ) z) := by
    rw [Complex.add_conj]
    push_cast
    ring
  rw [this]
  exact h2.mul (hz.add hconj)

lemma isAlgebraic_ofReal_im {z : ℂ} (hz : IsAlgebraic ℚ z) : IsAlgebraic ℚ (z.im : ℂ) := by
  have hI : IsAlgebraic ℚ Complex.I :=
    IsAlgebraic.of_pow (n := 2) two_pos (by rw [Complex.I_sq]; exact isAlgebraic_one.neg)
  have : (z.im : ℂ) = ((-Complex.I * z).re : ℂ) := by simp
  rw [this]
  exact isAlgebraic_ofReal_re (hI.neg.mul hz)

/-- Linearly independent linear forms with complex algebraic coefficients can be replaced by
linearly independent linear forms with real algebraic coefficients, without increasing their
absolute values at real points ([evertse1993], beginning of Section 3). -/
lemma exists_real_matrix [DecidableEq ι] (L : Matrix ι ι ℂ) (hL : L.det ≠ 0)
    (halg : ∀ i j, IsAlgebraic ℚ (L i j)) :
    ∃ M : Matrix ι ι ℝ, M.det ≠ 0 ∧ (∀ i j, IsAlgebraic ℚ (M i j)) ∧
      ∀ (x : ι → ℝ) (i : ι), |(M *ᵥ x) i| ≤ ‖(L *ᵥ fun j ↦ (x j : ℂ)) i‖ := by
  -- we replace the rows by real ones, one at a time
  have key : ∀ s : Finset ι, ∃ N : Matrix ι ι ℂ, N.det ≠ 0 ∧ (∀ i j, IsAlgebraic ℚ (N i j)) ∧
      (∀ i ∈ s, ∀ j, (N i j).im = 0) ∧
      ∀ (x : ι → ℝ) (i : ι), ‖(N *ᵥ fun j ↦ (x j : ℂ)) i‖ ≤ ‖(L *ᵥ fun j ↦ (x j : ℂ)) i‖ := by
    intro s
    induction s using Finset.induction_on with
    | empty => exact ⟨L, hL, halg, by simp, fun _ _ ↦ le_rfl⟩
    | insert a s has ih =>
      obtain ⟨N, hN, hNalg, hNim, hNle⟩ := ih
      have step : ∀ r : ι → ℝ, (N.updateRow a fun j ↦ (r j : ℂ)).det ≠ 0 →
          (∀ j, IsAlgebraic ℚ (r j : ℂ)) →
          (∀ x : ι → ℝ, |∑ j, r j * x j| ≤ ‖(N *ᵥ fun j ↦ (x j : ℂ)) a‖) →
          ∃ N : Matrix ι ι ℂ, N.det ≠ 0 ∧ (∀ i j, IsAlgebraic ℚ (N i j)) ∧
            (∀ i ∈ insert a s, ∀ j, (N i j).im = 0) ∧ ∀ (x : ι → ℝ) (i : ι),
              ‖(N *ᵥ fun j ↦ (x j : ℂ)) i‖ ≤ ‖(L *ᵥ fun j ↦ (x j : ℂ)) i‖ := by
        intro r hdet hr hrle
        refine ⟨N.updateRow a fun j ↦ (r j : ℂ), hdet, fun i j ↦ ?_, fun i hi j ↦ ?_,
          fun x i ↦ ?_⟩
        · rcases eq_or_ne i a with rfl | hia
          · simpa using hr j
          · simpa [Matrix.updateRow_ne hia] using hNalg i j
        · rcases eq_or_ne i a with rfl | hia
          · simp
          · rw [Matrix.updateRow_ne hia]
            exact hNim i ((Finset.mem_insert.mp hi).resolve_left hia) j
        · rcases eq_or_ne i a with rfl | hia
          · refine le_trans ?_ ((hrle x).trans (hNle x i))
            have : ((N.updateRow i fun j ↦ (r j : ℂ)) *ᵥ fun j ↦ (x j : ℂ)) i =
                ((∑ j, r j * x j : ℝ) : ℂ) := by
              simp [Matrix.mulVec, dotProduct]
            rw [this, Complex.norm_real, Real.norm_eq_abs]
          · have : ((N.updateRow a fun j ↦ (r j : ℂ)) *ᵥ fun j ↦ (x j : ℂ)) i =
                (N *ᵥ fun j ↦ (x j : ℂ)) i := by
              simp [Matrix.mulVec, Matrix.updateRow_ne hia]
            rw [this]
            exact hNle x i
      have hdet : N.det = (N.updateRow a fun j ↦ ((N a j).re : ℂ)).det +
          Complex.I * (N.updateRow a fun j ↦ ((N a j).im : ℂ)).det := by
        rw [← Matrix.det_updateRow_smul, ← Matrix.det_updateRow_add]
        congr 1
        conv_lhs => rw [← Matrix.updateRow_eq_self N a]
        congr 1
        ext j
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        rw [mul_comm, Complex.re_add_im]
      by_cases hre : (N.updateRow a fun j ↦ ((N a j).re : ℂ)).det = 0
      · have him : (N.updateRow a fun j ↦ ((N a j).im : ℂ)).det ≠ 0 := by
          intro h
          apply hN
          rw [hdet, hre, h]
          simp
        refine step (fun j ↦ (N a j).im) him (fun j ↦ isAlgebraic_ofReal_im (hNalg a j))
          fun x ↦ ?_
        have : (∑ j, (N a j).im * x j) = ((N *ᵥ fun j ↦ (x j : ℂ)) a).im := by
          simp [Matrix.mulVec, dotProduct]
        rw [this]
        exact Complex.abs_im_le_norm _
      · refine step (fun j ↦ (N a j).re) hre (fun j ↦ isAlgebraic_ofReal_re (hNalg a j))
          fun x ↦ ?_
        have : (∑ j, (N a j).re * x j) = ((N *ᵥ fun j ↦ (x j : ℂ)) a).re := by
          simp [Matrix.mulVec, dotProduct]
        rw [this]
        exact Complex.abs_re_le_norm _
  obtain ⟨N, hN, hNalg, hNim, hNle⟩ := key Finset.univ
  obtain ⟨M, hM⟩ : ∃ M : Matrix ι ι ℝ, N = M.map (algebraMap ℝ ℂ) := by
    refine ⟨Matrix.of fun i j ↦ (N i j).re, ?_⟩
    ext i j
    apply Complex.ext <;> simp [hNim i (Finset.mem_univ i) j]
  subst hM
  refine ⟨M, fun h ↦ hN ?_, fun i j ↦ ?_, fun x i ↦ le_trans ?_ (hNle x i)⟩
  · rw [← RingHom.mapMatrix_apply, ← RingHom.map_det, h, map_zero]
  · exact (isAlgebraic_algebraMap_iff (algebraMap ℝ ℂ).injective).mp (hNalg i j)
  · have : ((M.map (algebraMap ℝ ℂ)) *ᵥ fun j ↦ (x j : ℂ)) i = (((M *ᵥ x) i : ℝ) : ℂ) := by
      simp [Matrix.mulVec, dotProduct]
    rw [this, Complex.norm_real, Real.norm_eq_abs]

/-- **Schmidt's Subspace Theorem** for linear forms with complex algebraic coefficients, given by
the rows of an invertible matrix `L`: if `n ≥ 2` and `ε > 0`, then the set of solutions `x ∈ ℤⁿ` of
`|L₁(x) ⋯ Lₙ(x)| ≤ ‖x‖ ^ (-ε)` is contained in the union of finitely many proper linear subspaces
of `ℚⁿ`. -/
theorem subspace_theorem_complex [DecidableEq ι] [Nontrivial ι] (L : Matrix ι ι ℂ)
    (hL : L.det ≠ 0) (halg : ∀ i j, IsAlgebraic ℚ (L i j)) {ε : ℝ} (hε : 0 < ε) :
    CoveredByProperSubspaces
      {x : ι → ℤ | ‖∏ i, (L *ᵥ fun j ↦ (x j : ℂ)) i‖ ≤ ‖x‖ ^ (-ε)} := by
  obtain ⟨M, hM, hMalg, hML⟩ := exists_real_matrix L hL halg
  refine (subspace_theorem_real M hM hMalg hε).mono fun x hx ↦ ?_
  rw [mem_solutionSet, Finset.abs_prod]
  refine le_trans ?_ ((norm_prod _ _).symm.trans_le hx)
  gcongr with i
  simpa [eval] using hML (fun j ↦ (x j : ℝ)) i

/-- **Schmidt's Subspace Theorem** (W. M. Schmidt, 1972). Let `L₁, …, Lₙ` be linearly independent
linear forms in `n ≥ 2` variables with algebraic coefficients (in `ℂ`) and let `ε > 0`. Then there
are finitely many proper linear subspaces `T₁, …, Tₜ` of `ℚⁿ` such that every solution `x ∈ ℤⁿ` of
the inequality `|L₁(x) ⋯ Lₙ(x)| ≤ ‖x‖ ^ (-ε)` lies in `T₁ ∪ ⋯ ∪ Tₜ`. Here `‖x‖ = max |xᵢ|`.

This is [evertse1993], Theorem 1.5. -/
theorem subspace_theorem [DecidableEq ι] [Nontrivial ι] (L : ι → Module.Dual ℂ (ι → ℂ))
    (hL : LinearIndependent ℂ L) (halg : ∀ i j, IsAlgebraic ℚ (L i (Pi.single j 1)))
    {ε : ℝ} (hε : 0 < ε) :
    ∃ T : Finset (Submodule ℚ (ι → ℚ)), (∀ V ∈ T, V ≠ ⊤) ∧
      ∀ x : ι → ℤ, ‖∏ i, L i (fun j ↦ (x j : ℂ))‖ ≤ ‖x‖ ^ (-ε) →
        ∃ V ∈ T, (fun j ↦ (x j : ℚ)) ∈ V := by
  have hsingle (j : ι) : (fun k ↦ if j = k then (1 : ℂ) else 0) = Pi.single j 1 := by
    ext k
    simp [Pi.single_apply, eq_comm]
  -- the matrix of the coefficients
  let A : Matrix ι ι ℂ := Matrix.of fun i j ↦ L i (Pi.single j 1)
  have hA (i : ι) (v : ι → ℂ) : L i v = (A *ᵥ v) i := by
    rw [LinearMap.pi_apply_eq_sum_univ (L i) v]
    simp only [Matrix.mulVec, dotProduct, A, Matrix.of_apply, smul_eq_mul, hsingle, mul_comm]
  have hdet : A.det ≠ 0 := by
    let Ψ : Module.Dual ℂ (ι → ℂ) →ₗ[ℂ] (ι → ℂ) :=
      LinearMap.pi fun j ↦ LinearMap.applyₗ (Pi.single j (1 : ℂ))
    have hΨ : LinearMap.ker Ψ = ⊥ := by
      refine LinearMap.ker_eq_bot'.mpr fun f hf ↦ LinearMap.ext fun v ↦ ?_
      rw [LinearMap.pi_apply_eq_sum_univ f v]
      refine Finset.sum_eq_zero fun j _ ↦ ?_
      rw [hsingle, show f (Pi.single j 1) = Ψ f j from rfl, hf]
      simp
    have hrow : LinearIndependent ℂ A.row := hL.map' Ψ hΨ
    exact ((Matrix.isUnit_iff_isUnit_det A).mp
      (Matrix.linearIndependent_row_iff_isUnit.mp hrow)).ne_zero
  obtain ⟨T, hT, h⟩ := subspace_theorem_complex A hdet (fun i j ↦ halg i j) hε
  refine ⟨T, hT, fun x hx ↦ h x ?_⟩
  simpa [hA] using hx

end Schmidt
